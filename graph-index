#!/usr/bin/env python3
"""Executable shim so the tool can run as ``./graph-index``.

It only makes the sibling ``graphindex`` package importable and hands off
to the package's CLI; all real behaviour lives there.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from graphindex.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
